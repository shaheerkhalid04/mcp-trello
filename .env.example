# Trello REST API credentials.
# 1. Get your API key:   https://trello.com/power-ups/admin  (create a Power-Up, then "API key")
# 2. Generate a token:   click the "Token" link next to your API key and authorize.
# The token is tied to your Trello account and grants the access you approve.
TRELLO_API_KEY=your_api_key_here
TRELLO_TOKEN=your_token_here
